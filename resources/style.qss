QWidget { background: #182129; color: #e6edf2; font-size: 13px; }
QMainWindow::separator { background: #0c131a; width: 5px; height: 5px; }
QMenuBar { background: #10171e; border-bottom: 1px solid #293641; padding: 3px 8px; }
QMenuBar::item { padding: 5px 11px; background: transparent; }
QMenuBar::item:selected, QMenu::item:selected { background: #2b474c; color: #f1fffa; }
QMenu { background: #1b2730; border: 1px solid #425562; padding: 6px; }
QMenu::item { padding: 8px 30px 8px 14px; }
QMenu::separator { height: 1px; background: #354652; margin: 5px 10px; }
QToolBar { background: #121c24; border: 0; border-bottom: 1px solid #2b3c47; padding: 5px 10px; spacing: 3px; }
QToolBar::separator { background: #33444f; width: 1px; margin: 4px 7px; }
QToolButton { background: transparent; padding: 7px 8px; border: 1px solid transparent; border-radius: 5px; font-size: 12px; }
QToolButton:hover { background: #273945; }
QToolButton:checked { background: #274a4d; border-color: #5fb6aa; color: #eafff8; }
QToolButton:focus { border-color: #8ae0cb; }
QToolButton:disabled { color: #758794; }
QLabel#studioBrand { background: transparent; color: #94e0cd; font-size: 12px; font-weight: 700; }
QLabel#projectTitle { background: transparent; color: #b4c6d3; font-size: 12px; padding: 0 8px; }
QLabel[role="muted"] { color: #a8bcc9; font-size: 12px; background: transparent; }
QLabel[role="heading"] { font-size: 20px; font-weight: 600; padding: 3px 0; background: transparent; }
QDockWidget { font-weight: 600; }
QDockWidget::title { background: #1c2a33; border-bottom: 1px solid #30414e; padding: 10px 13px; }
QDockWidget::close-button, QDockWidget::float-button { border: 0; padding: 2px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background: #3b4f5d; }
QScrollArea { border: 0; }
QLineEdit, QComboBox, QPlainTextEdit, QDoubleSpinBox { background: #101a22; border: 1px solid #3e515f; padding: 7px; border-radius: 5px; selection-background-color: #35685e; min-height: 18px; }
QLineEdit:hover, QComboBox:hover, QDoubleSpinBox:hover { border-color: #658191; }
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QPushButton:focus, QTreeWidget:focus, QListWidget:focus { border: 1px solid #87dfc8; }
QLineEdit:disabled, QComboBox:disabled, QDoubleSpinBox:disabled { color: #8e9da8; background: #202c35; border-color: #334651; }
QComboBox::drop-down { border-left: 1px solid #344854; width: 23px; }
QComboBox::down-arrow { image: url(:/studio/arrow-down.png); width: 14px; height: 14px; }
QComboBox QAbstractItemView { background: #1d2c36; border: 1px solid #56707f; selection-background-color: #2d514f; padding: 4px; }
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 18px; border-left: 1px solid #344854; background: #24343f; }
QDoubleSpinBox::up-arrow { image: url(:/studio/arrow-up.png); width: 14px; height: 14px; }
QDoubleSpinBox::down-arrow { image: url(:/studio/arrow-down.png); width: 14px; height: 14px; }
QPushButton { background: #283b47; border: 1px solid #496171; padding: 9px 12px; border-radius: 5px; font-weight: 500; }
QPushButton:hover { background: #334d59; border-color: #7797a5; }
QPushButton:pressed { background: #1c323a; }
QPushButton:disabled { color: #92a1ac; background: #22313b; border-color: #344954; }
QPushButton[role="primary"] { color: #102721; background: #87d9c1; border-color: #a5ebd8; font-weight: 600; padding: 11px; }
QPushButton[role="primary"]:hover { background: #a0e5d2; }
QPushButton[role="primary"]:pressed { background: #6ec3ac; }
QPushButton[role="primary"]:disabled { color: #a6beb6; background: #35564e; border-color: #486c62; }
QPushButton[role="quiet"] { background: transparent; color: #b5c8d5; border-color: #354d5b; font-weight: 400; }
QListWidget { background: #172129; border: 1px solid #30434f; border-radius: 5px; outline: 0; }
QListWidget::item { border: 0; padding: 0; }
QTreeWidget { background: #141f27; border: 0; outline: 0; }
QTreeWidget::item { padding: 6px 2px; }
QTreeWidget::item:hover { background: #24343e; }
QTreeWidget::item:selected { background: #29494b; color: #edfff9; }
QHeaderView::section { background: #1a2a34; border: 0; border-bottom: 1px solid #354855; color: #b8cad5; padding: 7px 8px; font-size: 11px; }
QCheckBox { spacing: 7px; padding: 3px 0; }
QCheckBox::indicator { width: 15px; height: 15px; border: 1px solid #78929f; background: #17272f; border-radius: 3px; }
QCheckBox::indicator:checked { background: #72c5b0; border-color: #b2eddb; image: url(:/studio/check.png); }
QCheckBox::indicator:focus { border-color: #e6fff5; }
QStatusBar { background: #101a22; border-top: 1px solid #2d404c; font-size: 11px; }
QStatusBar::item { border: 0; }
QTabBar::tab { background: #1a2a34; color: #a7bdca; padding: 9px 17px; border: 0; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { background: #243b43; color: #a4ebd7; border-bottom-color: #87d9c1; }
QScrollBar:vertical { width: 10px; background: #15212a; margin: 2px; }
QScrollBar:horizontal { height: 10px; background: #15212a; margin: 2px; }
QScrollBar::handle { background: #4a6574; min-height: 28px; min-width: 28px; border-radius: 4px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QProgressBar { background: #101b23; border: 1px solid #35505d; border-radius: 3px; max-height: 5px; min-height: 5px; }
QProgressBar::chunk { background: #7bd1b8; border-radius: 2px; }
QToolTip { background: #253945; color: #ecf7fb; padding: 7px 9px; border: 1px solid #70919d; }
QGraphicsView { border: 0; }
